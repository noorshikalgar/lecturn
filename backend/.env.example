NODE_ENV=development
PORT=8787
# 127.0.0.1 for local dev. Docker deployments must set this to 0.0.0.0.
HOST=127.0.0.1
DB_PATH=./data/lecturn.db
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
# Root folder the scanner walks. On the box that has the real library this is
# the bind-mounted path, e.g. /mnt/courses. Must be readable, never written to.
COURSES_ROOT=./sample-courses
