NODE_ENV=development
PORT=8787
# 127.0.0.1 for local dev. Docker deployments must set this to 0.0.0.0.
HOST=127.0.0.1
DB_PATH=./data/lecturn.db
# Comma-separated. To test on a phone/tablet on the same LAN (with the
# frontend's `vite.config.ts` server.host set to 0.0.0.0), add that device's
# origin too, e.g. http://localhost:5173,http://192.168.1.23:5173 — the
# phone's requests carry that LAN IP as their Origin header, and anything
# not listed here gets CORS-blocked.
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
# Only set this to true once a reverse proxy is terminating real TLS in
# front of the app — a browser silently drops a Secure cookie over plain
# HTTP, which is how this app is documented to run by default (see DEPLOY.md).
COOKIE_SECURE=false
# Optional. If unset, a persistent Ed25519 key is generated once on first
# boot and stored at certificate_signing_key.pem next to DB_PATH — course
# certificates stay verifiable across restarts with zero setup. Only set
# this yourself if you want to manage/rotate the key, or share one signing
# identity across multiple instances. Generate a value with:
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
CERTIFICATE_SIGNING_PRIVATE_KEY=
