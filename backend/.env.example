NODE_ENV=development
PORT=8787
# 127.0.0.1 for local dev. Docker deployments must set this to 0.0.0.0.
HOST=127.0.0.1
DB_PATH=./data/lecturn.db
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
# Only set this to true once a reverse proxy is terminating real TLS in
# front of the app — a browser silently drops a Secure cookie over plain
# HTTP, which is how this app is documented to run by default (see DEPLOY.md).
COOKIE_SECURE=false
