# Used by docker-compose.yml
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying
FRONTEND_ORIGIN=http://localhost:8080
# Real path on the host where your course library lives, bind-mounted read-only.
COURSES_HOST_PATH=/mnt/courses
HTTP_PORT=8080
# Leave false for the default plain-HTTP setup above. Only set to true if
# you've put a reverse proxy (e.g. Caddy, nginx, Traefik) in front of this
# stack that terminates real TLS — a browser silently drops a `Secure`
# cookie over plain HTTP, so setting this to true without TLS in front
# breaks login outright.
COOKIE_SECURE=false
